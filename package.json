{
  "name": "pitglass",
  "version": "0.1.0",
  "description": "Turn any phone or tablet into a live sim dashboard: Assetto Corsa, Euro Truck Simulator 2, BeamNG, Motor Town and Flight Simulator telemetry, served from your PC over the local network.",
  "license": "MIT",
  "author": "agentkyo <caioviniciusxd@gmail.com>",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node src/server/main.ts",
    "serve": "node src/server/main.ts",
    "demo": "node scripts/build.mjs && node src/server/main.ts --demo car",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "koffi": "^3.3.8",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
